{
  "name": "ksef-invoice-fetcher",
  "version": "0.6.0",
  "description": "Aplikacja do pobierania faktur z KSeF API 2.0",
  "license": "ISC",
  "author": "Paweł Franczyk",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "ksef": "src/index.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "auth": "node src/index.ts",
    "fetch": "node src/index.ts --df",
    "generate-pdf": "node src/index.ts --generate-pdf",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pfranczyk/ksef-invoice-fetcher"
  },
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^14.0.3",
    "docxtemplater": "^3.68.3",
    "dotenv": "^17.3.1",
    "node-forge": "^1.3.3",
    "pizzip": "^3.2.0",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^25.3.1",
    "@types/node-forge": "^1.3.14",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
