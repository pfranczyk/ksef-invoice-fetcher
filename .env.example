# KSeF Environment Configuration
# Skopiuj ten plik jako .env i dostosuj wartości

# Środowisko KSeF (TEST, DEMO, PRD)
KSEF_ENV=DEMO

# Uwierzytelnianie - Certyfikaty
CERT_PATH=./certs/ksef.crt
CERT_KEY_PATH=./certs/ksef.key
CERT_PASSWORD=your_cert_password_here
TOKEN_PATH=./tokens/ksef.token

# Klucz publiczny KSeF dla szyfrowania AES (różny dla każdego środowiska)
KSEF_PUBLIC_KEY_PATH=./certs/ksef-public.pem

# NIP podmiotu (kontekst uwierzytelniania)
NIP=0000000000

# Katalogi
OUTPUT_DIR=./output
TEMP_DIR=./tmp

# Szablon DOCX dla generowania PDF
TEMPLATE_DOCX=./templates/invoice-template.docx

# Przechowywanie tokenów JWT
TOKEN_STORAGE_PATH=./tokens/ksef-tokens.json

# Opcjonalne - Margin dla odświeżania tokenów (minuty)
TOKEN_REFRESH_MARGIN_MINUTES=5

# Eksport faktur
# Interwał pollingu statusu eksportu (sekundy)
EXPORT_POLL_INTERVAL_SECONDS=5
# Maksymalny czas oczekiwania na zakończenie eksportu (minuty, 0 = brak limitu)
EXPORT_STATUS_MAX_WAIT_MINUTES=0

# LibreOffice - wymagane dla generowania PDF
# Ścieżka do LibreOffice (soffice / soffice.exe)
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
# Linux:   /usr/bin/soffice
# macOS:   /Applications/LibreOffice.app/Contents/MacOS/soffice
LIBREOFFICE_PATH=/usr/bin/soffice
